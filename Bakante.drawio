          <mxGeometry height="80" width="285" x="710" y="395" as="geometry" />
        </mxCell>
        <mxCell id="e1" edge="1" parent="1" source="s1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#334155;strokeWidth=1.5;endArrow=classic;endFill=1;" target="s2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" edge="1" parent="1" source="s2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#334155;strokeWidth=1.5;endArrow=classic;endFill=1;" target="d1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" edge="1" parent="1" source="d1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#dc2626;strokeWidth=1.5;fontColor=#dc2626;fontStyle=1;labelBackgroundColor=#ffffff;endArrow=classic;endFill=1;" target="err-box" value="No">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" edge="1" parent="1" source="d1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#334155;strokeWidth=1.5;fontColor=#0f172a;fontStyle=1;labelBackgroundColor=#ffffff;endArrow=classic;endFill=1;" target="s3" value="Yes">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" edge="1" parent="1" source="s3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#334155;strokeWidth=1.5;endArrow=classic;endFill=1;" target="d2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" edge="1" parent="1" source="d2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#16a34a;strokeWidth=1.5;fontColor=#16a34a;fontStyle=1;labelBackgroundColor=#ffffff;endArrow=classic;endFill=1;" target="ok-box" value="No (Free)">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e7" edge="1" parent="1" source="d2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#334155;strokeWidth=1.5;fontColor=#0f172a;fontStyle=1;labelBackgroundColor=#ffffff;endArrow=classic;endFill=1;exitX=1;exitY=0.5;entryX=1;entryY=0.5;" target="alt-box" value="Yes (Busy)">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1195" y="168" />
              <mxPoint x="1195" y="435" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e8" edge="1" parent="1" source="alt-box" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;strokeColor=#2563eb;strokeWidth=1.5;fontColor=#2563eb;fontStyle=1;labelBackgroundColor=#ffffff;endArrow=classic;endFill=1;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" target="s3" value="Pick Alternative (Re-check)">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="note-title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=13;fontStyle=1;fontColor=#0f172a;" value="Quick Guide: What the Terms Mean" vertex="1">
          <mxGeometry height="24" width="350" x="40" y="500" as="geometry" />
        </mxCell>
        <mxCell id="note1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;strokeWidth=1;fontColor=#334155;fontSize=11;align=left;spacingLeft=10;spacingRight=8;" value="What is O(1) — Constant Time?&#xa;Takes the same instant speed whether there are 10 or 10,000 bookings, because it only checks the 1 new request (fields, room ID, hours, seats)." vertex="1">
          <mxGeometry height="75" width="275" x="40" y="530" as="geometry" />
        </mxCell>
        <mxCell id="note2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;strokeWidth=1;fontColor=#334155;fontSize=11;align=left;spacingLeft=10;spacingRight=8;" value="What is O(log n) — Binary Search?&#xa;Instead of reading every row 1-by-1 like a spreadsheet, it cuts the sorted schedule in half each step (1,000 rows = ~10 checks max)." vertex="1">
          <mxGeometry height="75" width="275" x="335" y="530" as="geometry" />
        </mxCell>
        <mxCell id="note3" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;strokeWidth=1;fontColor=#334155;fontSize=11;align=left;spacingLeft=10;spacingRight=8;" value="Why startA &lt; endB AND startB &lt; endA?&#xa;Both are true ONLY when two times overlap. Back-to-back (9–11 AM &amp; 11–1 PM) fails 11 &lt; 11, so it is safely allowed." vertex="1">
          <mxGeometry height="75" width="275" x="630" y="530" as="geometry" />
        </mxCell>
        <mxCell id="note4" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;strokeWidth=1;fontColor=#334155;fontSize=11;align=left;spacingLeft=10;spacingRight=8;" value="Why 100-Pt Best-Fit Score?&#xa;Ranks free rooms so a 50-person class gets AVR 2 (80 seats, 83%) instead of wasting the 500-seat Gym (40%)." vertex="1">
          <mxGeometry height="75" width="275" x="925" y="530" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="2. System Architecture" id="bakante-architecture">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="1180" pageHeight="540" math="0" shadow="0">
