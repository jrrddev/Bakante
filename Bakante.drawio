<mxfile host="Electron">
  <diagram name="1. Booking Flow" id="bakante-booking-flow">
    <mxGraphModel dx="1200" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="620" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="t1" value="BAKANTE — How Room Booking Works" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0f295c;strokeColor=#0f295c;fontColor=#ffffff;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="30" width="980" height="48" as="geometry" />
        </mxCell>

        <!-- 1. Start -->
        <mxCell id="s1" value="1. Request Room&#xa;Pick room, date &amp; time" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fillColor=#dbeafe;strokeColor=#2563eb;fontColor=#1e3a8a;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="210" width="170" height="70" as="geometry" />
        </mxCell>

        <!-- 2. Validate Decision -->
        <mxCell id="d1" value="2. Valid Details?&#xa;(Fields, Hours, Cap)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;fontColor=#78350f;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="290" y="195" width="160" height="100" as="geometry" />
        </mxCell>

        <!-- Block Bad Input -->
        <mxCell id="e1-box" value="Block Bad Input&#xa;(0% Errors)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#dc2626;fontColor=#7f1d1d;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="295" y="365" width="150" height="65" as="geometry" />
        </mxCell>

        <!-- 3. Check Schedule -->
        <mxCell id="s2" value="3. Check Schedule&#xa;Fast Binary Search" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0f2fe;strokeColor=#0284c7;fontColor=#0c4a6e;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="515" y="210" width="165" height="70" as="geometry" />
        </mxCell>

        <!-- 4. Conflict Decision -->
        <mxCell id="d2" value="4. Time Slot&#xa;Free?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fef9c3;strokeColor=#ca8a04;fontColor=#713f12;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="735" y="195" width="135" height="100" as="geometry" />
        </mxCell>

        <!-- 5A. Booked -->
        <mxCell id="ok-box" value="5A. Booking Saved!&#xa;(0% Conflicts)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontColor=#14532d;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="920" y="130" width="150" height="70" as="geometry" />
        </mxCell>

        <!-- 5B. Suggest Alternatives -->
        <mxCell id="alt-box" value="5B. Suggest Best-Fit&#xa;Room or Open Time" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffedd5;strokeColor=#ea580c;fontColor=#7c2d12;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="895" y="320" width="175" height="70" as="geometry" />
        </mxCell>

        <!-- Edges -->
        <mxCell id="f1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#334155;strokeWidth=2;" edge="1" parent="1" source="s1" target="d1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f2" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#dc2626;strokeWidth=2;fontColor=#dc2626;fontStyle=1;" edge="1" parent="1" source="d1" target="e1-box">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f3" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#16a34a;strokeWidth=2;fontColor=#16a34a;fontStyle=1;" edge="1" parent="1" source="d1" target="s2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#334155;strokeWidth=2;" edge="1" parent="1" source="s2" target="d2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f5" value="Yes (Free)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#16a34a;strokeWidth=2;fontColor=#16a34a;fontStyle=1;exitX=0.5;exitY=0;" edge="1" parent="1" source="d2" target="ok-box">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f6" value="No (Busy)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#ea580c;strokeWidth=2;fontColor=#ea580c;fontStyle=1;exitX=0.5;exitY=1;" edge="1" parent="1" source="d2" target="alt-box">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f7" value="Pick Alternative" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;strokeColor=#2563eb;strokeWidth=2;fontColor=#2563eb;fontStyle=1;exitX=0.5;exitY=1;entryX=0.5;entryY=1;" edge="1" parent="1" source="alt-box" target="s2">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="982" y="455" />
              <mxPoint x="598" y="455" />
            </Array>
          </mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram name="2. Baseline Flow" id="bakante-baseline-flow">
    <mxGraphModel dx="1200" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="520" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="bt1" value="BAKANTE — Manual Baseline vs. New System Scorecard" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0f295c;strokeColor=#0f295c;fontColor=#ffffff;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="30" width="980" height="48" as="geometry" />
        </mxCell>

        <mxCell id="b1" value="1. 20 Sample Requests&#xa;(10 Valid · 6 Conflicts · 4 Errors)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontColor=#1e3a8a;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="70" y="210" width="220" height="80" as="geometry" />
        </mxCell>

        <mxCell id="b2" value="2A. Manual Spreadsheet&#xa;(Timed with Stopwatch)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;fontColor=#78350f;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="380" y="135" width="240" height="75" as="geometry" />
        </mxCell>

        <mxCell id="b3" value="2B. Bakante Replay&#xa;(Automated SQLite Check)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontColor=#14532d;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="380" y="285" width="240" height="75" as="geometry" />
        </mxCell>

        <mxCell id="b4" value="3. Official Scorecard&#xa;% Improvement in:&#xa;• Processing Time&#xa;• Conflict Rate&#xa;• Error Rate" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0f295c;strokeColor=#0f295c;fontColor=#ffffff;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="730" y="190" width="250" height="120" as="geometry" />
        </mxCell>

        <mxCell id="bf1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#334155;strokeWidth=2;" edge="1" parent="1" source="b1" target="b2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="bf2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#334155;strokeWidth=2;" edge="1" parent="1" source="b1" target="b3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="bf3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#334155;strokeWidth=2;" edge="1" parent="1" source="b2" target="b4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="bf4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#334155;strokeWidth=2;" edge="1" parent="1" source="b3" target="b4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
