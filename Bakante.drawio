          <mxGeometry height="90" width="220" x="870" y="75" as="geometry" />
        </mxCell>
        <mxCell id="a-mem" parent="1" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#ffffff;strokeColor=#334155;strokeWidth=1.5;fontColor=#0f172a;fontSize=12;" value="In-Memory Sandbox&#xa;~5 ms Scorecard &amp; Excel Replay" vertex="1">
