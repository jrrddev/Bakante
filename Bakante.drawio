        <mxCell id="s1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fillColor=#ffffff;strokeColor=#334155;strokeWidth=1.5;fontColor=#0f172a;fontSize=12;" value="Start: User Enters Booking&#xa;(Room, Date, Start–End, Attendees)&#xa;min = (Hour × 60) + Min" vertex="1">
