          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ae2" edge="1" parent="1" source="a-vercel" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#334155;strokeWidth=1.5;endArrow=classic;endFill=1;" target="a-server">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ae3" edge="1" parent="1" source="a-server" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#334155;strokeWidth=1.5;fontColor=#0f172a;labelBackgroundColor=#ffffff;endArrow=classic;endFill=1;exitX=1;exitY=0.3;entryX=0;entryY=0.5;" target="a-turso" value="Live CRUD">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ae4" edge="1" parent="1" source="a-server" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#334155;strokeWidth=1.5;fontColor=#0f172a;labelBackgroundColor=#ffffff;endArrow=classic;endFill=1;exitX=1;exitY=0.7;entryX=0;entryY=0.5;" target="a-mem" value="Replay">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ae5" edge="1" parent="1" source="a-client" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;strokeColor=#64748b;strokeWidth=1.5;endArrow=classic;endFill=1;exitX=0.5;exitY=1;entryX=0.2;entryY=0;" target="a-shared">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ae6" edge="1" parent="1" source="a-server" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;strokeColor=#64748b;strokeWidth=1.5;endArrow=classic;endFill=1;exitX=0.5;exitY=1;entryX=0.8;entryY=0;" target="a-shared">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="anote1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;strokeWidth=1;fontColor=#334155;fontSize=11;align=left;spacingLeft=10;spacingRight=8;" value="Why Shared Rules (shared/)?&#xa;Both the website preview and the API server run the exact same code—so rules never contradict each other." vertex="1">
          <mxGeometry height="65" width="330" x="40" y="430" as="geometry" />
        </mxCell>
        <mxCell id="anote2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;strokeWidth=1;fontColor=#334155;fontSize=11;align=left;spacingLeft=10;spacingRight=8;" value="Why Turso Cloud?&#xa;Saves real bookings in persistent cloud SQLite so data stays intact across Vercel serverless requests." vertex="1">
          <mxGeometry height="65" width="330" x="400" y="430" as="geometry" />
        </mxCell>
        <mxCell id="anote3" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;strokeWidth=1;fontColor=#334155;fontSize=11;align=left;spacingLeft=10;spacingRight=8;" value="Why In-Memory Sandbox?&#xa;Replays 20-request or Excel batches in ~5 ms without touching or cluttering your live campus schedule." vertex="1">
          <mxGeometry height="65" width="330" x="760" y="430" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="3. 3-Way Scorecard Flow" id="bakante-baseline-flow">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="1200" pageHeight="540" math="0" shadow="0">
      <root>
