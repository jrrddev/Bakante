        </mxCell>
        <mxCell id="a-client" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#334155;strokeWidth=1.5;fontColor=#0f172a;fontSize=12;" value="Web App (client/)&#xa;React + Vite + Tailwind&#xa;Schedule · Modal · Scorecard · Algorithm" vertex="1">
