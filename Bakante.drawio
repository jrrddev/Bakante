        <mxCell id="bt1" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=16;fontStyle=1;fontColor=#0f172a;" value="Bakante — 3-Way Scorecard Flowchart" vertex="1">
          <mxGeometry height="32" width="520" x="40" y="20" as="geometry" />
        </mxCell>
        <mxCell id="b1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fillColor=#ffffff;strokeColor=#334155;strokeWidth=1.5;fontColor=#0f172a;fontSize=12;" value="20 Test Requests&#xa;10 Valid · 6 Conflicts (30%) · 4 Errors (20%)" vertex="1">
          <mxGeometry height="75" width="235" x="40" y="210" as="geometry" />
        </mxCell>
        <mxCell id="b2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#334155;strokeWidth=1.5;fontColor=#0f172a;fontSize=12;" value="1. Manual Walk-In &amp; Sheet&#xa;360.0 sec · 30% conflicts · 20% errors" vertex="1">
          <mxGeometry height="70" width="260" x="345" y="100" as="geometry" />
        </mxCell>
        <mxCell id="b2m" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#334155;strokeWidth=1.5;fontColor=#0f172a;fontSize=12;" value="2. Bakante Manual (1-by-1 Form)&#xa;120.0 sec (66.67% faster) · 0% conflicts &amp; errors" vertex="1">
          <mxGeometry height="70" width="260" x="345" y="212" as="geometry" />
        </mxCell>
        <mxCell id="b3" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#334155;strokeWidth=1.5;fontColor=#0f172a;fontSize=12;" value="3. Bakante Batch (Excel / CSV)&#xa;~0.005 sec (99.99% faster) · 0% conflicts &amp; errors" vertex="1">
          <mxGeometry height="70" width="260" x="345" y="325" as="geometry" />
        </mxCell>
        <mxCell id="b4" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#334155;strokeWidth=1.5;fontColor=#0f172a;fontSize=12;" value="Section 9.1 Formula&#xa;% Gain = |Manual − Bakante| ÷ Manual × 100" vertex="1">
          <mxGeometry height="75" width="250" x="675" y="210" as="geometry" />
        </mxCell>
        <mxCell id="b5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fillColor=#f0fdf4;strokeColor=#16a34a;strokeWidth=1.5;fontColor=#166534;fontSize=12;fontStyle=1;" value="Final Scorecard&#xa;Time: 66.67% / 99.99% faster&#xa;Conflicts &amp; Errors: 100% cut" vertex="1">
          <mxGeometry height="85" width="190" x="980" y="205" as="geometry" />
        </mxCell>
        <mxCell id="bf1" edge="1" parent="1" source="b1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#334155;strokeWidth=1.5;endArrow=classic;endFill=1;exitX=1;exitY=0.3;entryX=0;entryY=0.5;" target="b2">
