        <mxCell id="gate1-bg" parent="1" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fillColor=#f8fafc;strokeColor=#cbd5e1;dashed=1;dashPattern=4 4;fontColor=#475569;fontSize=11;fontStyle=1;" value="GATE 1 · INPUT CHECK" vertex="1">
