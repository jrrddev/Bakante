        <mxCell id="bf2" edge="1" parent="1" source="b1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#334155;strokeWidth=1.5;endArrow=classic;endFill=1;" target="b2m">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="bf3" edge="1" parent="1" source="b1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#334155;strokeWidth=1.5;endArrow=classic;endFill=1;exitX=1;exitY=0.7;entryX=0;entryY=0.5;" target="b3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="bf4" edge="1" parent="1" source="b2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#334155;strokeWidth=1.5;endArrow=classic;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.3;" target="b4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="bf5" edge="1" parent="1" source="b2m" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#334155;strokeWidth=1.5;endArrow=classic;endFill=1;" target="b4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="bf6" edge="1" parent="1" source="b3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#334155;strokeWidth=1.5;endArrow=classic;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.7;" target="b4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="bf7" edge="1" parent="1" source="b4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#334155;strokeWidth=1.5;endArrow=classic;endFill=1;" target="b5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="bnote1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;strokeWidth=1;fontColor=#334155;fontSize=11;align=left;spacingLeft=10;spacingRight=8;" value="Why 30% &amp; 20% Manual Rates?&#xa;Out of 20 requests, 6 are overlap traps (6 ÷ 20 = 30%) and 4 are invalid entries (4 ÷ 20 = 20%). An unvalidated sheet lets them in." vertex="1">
          <mxGeometry height="65" width="360" x="40" y="430" as="geometry" />
        </mxCell>
        <mxCell id="bnote2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;strokeWidth=1;fontColor=#334155;fontSize=11;align=left;spacingLeft=10;spacingRight=8;" value="Why Two Bakante Speeds?&#xa;Typing 20 bookings one-by-one in Bakante takes ~120s (66.67% faster than 360s). Uploading an Excel/CSV batch takes ~5 ms (99.99% faster)." vertex="1">
          <mxGeometry height="65" width="360" x="425" y="430" as="geometry" />
        </mxCell>
        <mxCell id="bnote3" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;strokeWidth=1;fontColor=#334155;fontSize=11;align=left;spacingLeft=10;spacingRight=8;" value="Why 99.99% instead of 100.00%?&#xa;Because 5 ms is still greater than 0 seconds, we cap non-zero time improvements at 99.99% for mathematical honesty." vertex="1">
          <mxGeometry height="65" width="360" x="810" y="430" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
