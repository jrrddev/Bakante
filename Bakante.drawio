<mxfile host="Electron">
  <diagram name="1. Booking Flow" id="bakante-booking-flow">
    <mxGraphModel dx="1480" dy="760" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1440" pageHeight="660" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Subtle Background Phase Zones (drawn first so they sit behind nodes) -->
        <mxCell id="zone1" value="PHASE 1 · INPUT &amp; VALIDATION GATE" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fillColor=#f8fafc;strokeColor=#cbd5e1;dashed=1;dashPattern=6 4;fontColor=#475569;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="30" y="96" width="640" height="414" as="geometry" />
        </mxCell>
        <mxCell id="zone2" value="PHASE 2 · ATOMIC CONFLICT ENGINE" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fillColor=#f0f9ff;strokeColor=#bae6fd;dashed=1;dashPattern=6 4;fontColor=#0369a1;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="688" y="96" width="404" height="414" as="geometry" />
        </mxCell>
        <mxCell id="zone3" value="PHASE 3 · OUTCOME &amp; RESOLUTION" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fillColor=#f8fafc;strokeColor=#cbd5e1;dashed=1;dashPattern=6 4;fontColor=#475569;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1110" y="96" width="300" height="414" as="geometry" />
        </mxCell>

        <!-- Header Banner + ISATU Gold Accent -->
        <mxCell id="t1" value="&lt;b style=&quot;font-size:17px;&quot;&gt;BAKANTE — Real-Time Booking, Conflict-Prevention &amp;amp; Best-Fit Flow&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:11px;color:#bfdbfe;&quot;&gt;Tech4ISATU Track 5 · University Operations: Facility &amp;amp; Room Booking (9 ISATU Campus Rooms)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0f295c;strokeColor=#0f295c;fontColor=#ffffff;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="30" y="20" width="1380" height="58" as="geometry" />
        </mxCell>
        <mxCell id="t1-gold" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f59e0b;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="30" y="75" width="1380" height="5" as="geometry" />
        </mxCell>

        <!-- 1. Request Input -->
        <mxCell id="s1" value="&lt;b style=&quot;font-size:13px;&quot;&gt;1. Booking Request&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:11px;&quot;&gt;Room ID, Date, Start–End,&lt;br/&gt;Requester, Office, Attendees&lt;/span&gt;&lt;br/&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:10.5px;&quot;&gt;min = (HH × 60) + MM&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=16;fillColor=#eff6ff;strokeColor=#2563eb;strokeWidth=2;fontColor=#1e3a8a;shadow=1;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="45" y="195" width="195" height="110" as="geometry" />
        </mxCell>

        <!-- 2. Input Gatekeeper -->
        <mxCell id="s2" value="&lt;b style=&quot;font-size:13px;&quot;&gt;2. Input Gatekeeper [O(1)]&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:11px;&quot;&gt;• Non-empty fields &amp;amp; valid Room ID&lt;br/&gt;• &lt;font face=&quot;Courier New&quot;&gt;420 ≤ startMin &amp;lt; endMin ≤ 1260&lt;/font&gt;&lt;br/&gt;• &lt;font face=&quot;Courier New&quot;&gt;1 ≤ attendees ≤ room.capacity&lt;/font&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#fffbeb;strokeColor=#d97706;strokeWidth=2;fontColor=#78350f;shadow=1;spacing=8;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="275" y="190" width="240" height="120" as="geometry" />
        </mxCell>

        <!-- Decision 1 -->
        <mxCell id="d1" value="&lt;b&gt;Valid&lt;br/&gt;Input?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fef9c3;strokeColor=#ca8a04;strokeWidth=2;fontColor=#713f12;fontSize=12;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="550" y="205" width="100" height="90" as="geometry" />
        </mxCell>

        <!-- Reject Invalid -->
        <mxCell id="err-box" value="&lt;b style=&quot;font-size:12.5px;&quot;&gt;Reject Request (HTTP 400)&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:11px;&quot;&gt;Blocks typos, inverted times,&lt;br/&gt;&amp;amp; overcrowding → &lt;b&gt;0% Error Rate&lt;/b&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#fef2f2;strokeColor=#dc2626;strokeWidth=2;fontColor=#7f1d1d;shadow=1;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="440" y="385" width="215" height="90" as="geometry" />
        </mxCell>

        <!-- 3. Atomic Binary Search -->
        <mxCell id="s3" value="&lt;b style=&quot;font-size:13px;&quot;&gt;3. Atomic Binary Search [O(log n)]&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:11px;&quot;&gt;• Lock: &lt;font face=&quot;Courier New&quot;&gt;BEGIN IMMEDIATE ... COMMIT&lt;/font&gt;&lt;br/&gt;• Index: &lt;font face=&quot;Courier New&quot;&gt;(facility_id, date, start_min)&lt;/font&gt;&lt;br/&gt;• Overlap Equation:&lt;br/&gt;&amp;nbsp;&amp;nbsp;&lt;b&gt;&lt;font face=&quot;Courier New&quot;&gt;startA &amp;lt; endB AND startB &amp;lt; endA&lt;/font&gt;&lt;/b&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#e0f2fe;strokeColor=#0284c7;strokeWidth=2;fontColor=#0c4a6e;shadow=1;spacing=8;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="705" y="182" width="248" height="136" as="geometry" />
        </mxCell>

        <!-- Decision 2 -->
        <mxCell id="d2" value="&lt;b&gt;Overlap&lt;br/&gt;Found?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fef9c3;strokeColor=#ca8a04;strokeWidth=2;fontColor=#713f12;fontSize=12;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="980" y="205" width="100" height="90" as="geometry" />
        </mxCell>

        <!-- 4A. Confirmed -->
        <mxCell id="ok-box" value="&lt;b style=&quot;font-size:13px;&quot;&gt;4A. Booking Saved (HTTP 201)&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:11px;&quot;&gt;Back-to-back [09:00,11:00) &amp;amp; [11:00,13:00)&lt;br/&gt;passes (11:00 &amp;lt; 11:00 is FALSE)&lt;br/&gt;→ &lt;b&gt;0% Double-Booking Rate&lt;/b&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#f0fdf4;strokeColor=#16a34a;strokeWidth=2;fontColor=#14532d;shadow=1;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1125" y="130" width="270" height="100" as="geometry" />
        </mxCell>

        <!-- 4B. Smart Suggester -->
        <mxCell id="alt-box" value="&lt;b style=&quot;font-size:12.5px;&quot;&gt;4B. Blocked (HTTP 409) + Suggester&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:10.5px;&quot;&gt;• Free Gaps: &lt;font face=&quot;Courier New&quot;&gt;next.start − cursor ≥ dur&lt;/font&gt;&lt;br/&gt;• Best-Fit Room Score (100 pts):&lt;br/&gt;&lt;b&gt;&lt;font face=&quot;Courier New&quot;&gt;45(att/cap) + 35(gear) + 20(bldg)&lt;/font&gt;&lt;/b&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#fff7ed;strokeColor=#ea580c;strokeWidth=2;fontColor=#7c2d12;shadow=1;spacing=8;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="1125" y="365" width="270" height="110" as="geometry" />
        </mxCell>

        <!-- Equation Quick-Reference Footer -->
        <mxCell id="footer1" value="&lt;b&gt;Core Guarantees:&lt;/b&gt;&amp;nbsp;&amp;nbsp;① O(1) Gatekeeper → 0% Errors&amp;nbsp;&amp;nbsp;|&amp;nbsp;&amp;nbsp;② O(log n) Sorted Binary Search + SQLite Lock → 0% Conflicts&amp;nbsp;&amp;nbsp;|&amp;nbsp;&amp;nbsp;③ 100-Pt Best-Fit Scorer → 1-Click Resolution" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#cbd5e1;fontColor=#334155;fontSize=11.5;" vertex="1" parent="1">
          <mxGeometry x="30" y="592" width="1380" height="36" as="geometry" />
        </mxCell>

        <!-- Clean Non-Crossing Orthogonal Edges -->
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#334155;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="s1" target="s2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#334155;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="s2" target="d1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="NO" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#dc2626;strokeWidth=2;fontColor=#dc2626;fontStyle=1;labelBackgroundColor=#f8fafc;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.74;entryY=0;" edge="1" parent="1" source="d1" target="err-box">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" value="YES" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#16a34a;strokeWidth=2;fontColor=#16a34a;fontStyle=1;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="d1" target="s3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0284c7;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="s3" target="d2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" value="NO (Free)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#16a34a;strokeWidth=2;fontColor=#16a34a;fontStyle=1;labelBackgroundColor=#f0f9ff;endArrow=block;endFill=1;exitX=0.5;exitY=0;entryX=0;entryY=0.5;" edge="1" parent="1" source="d2" target="ok-box">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1030" y="180" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e7" value="YES (Conflict)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#ea580c;strokeWidth=2;fontColor=#ea580c;fontStyle=1;labelBackgroundColor=#f0f9ff;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="d2" target="alt-box">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1030" y="420" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e8" value="1-Click Apply Alternative (Re-check)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;dashPattern=6 4;strokeColor=#2563eb;strokeWidth=2;fontColor=#2563eb;fontStyle=1;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=1;" edge="1" parent="1" source="alt-box" target="s3">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1260" y="545" />
              <mxPoint x="829" y="545" />
            </Array>
          </mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram name="2. Baseline Flow" id="bakante-baseline-flow">
    <mxGraphModel dx="1400" dy="680" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1360" pageHeight="560" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Subtle Background Comparison Zone -->
        <mxCell id="bzone" value="SIDE-BY-SIDE EVALUATION (SAME 20-REQUEST DATASET)" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fillColor=#f8fafc;strokeColor=#cbd5e1;dashed=1;dashPattern=6 4;fontColor=#475569;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="380" y="102" width="340" height="350" as="geometry" />
        </mxCell>

        <!-- Header Banner + Gold Accent -->
        <mxCell id="bt1" value="&lt;b style=&quot;font-size:17px;&quot;&gt;BAKANTE — Hybrid Manual Baseline vs. Automated Replay Scorecard&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:11px;color:#bfdbfe;&quot;&gt;Tech4ISATU Section 9.1–9.4 Evaluation Pipeline (3 Locked Parameters)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0f295c;strokeColor=#0f295c;fontColor=#ffffff;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="30" y="20" width="1300" height="58" as="geometry" />
        </mxCell>
        <mxCell id="bt1-gold" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f59e0b;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="30" y="75" width="1300" height="5" as="geometry" />
        </mxCell>

        <!-- 1. Shared Dataset -->
        <mxCell id="b1" value="&lt;b style=&quot;font-size:13px;&quot;&gt;1. Shared 20-Request Dataset&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:11px;&quot;&gt;&lt;font face=&quot;Courier New&quot;&gt;baseline/dataset.csv&lt;/font&gt; · 9 ISATU Rooms&lt;br/&gt;• &lt;b&gt;10 Valid&lt;/b&gt; (incl. back-to-back)&lt;br/&gt;• &lt;b&gt;6 Conflict Traps&lt;/b&gt; (dup, nested, span)&lt;br/&gt;• &lt;b&gt;4 Error Traps&lt;/b&gt; (blank, typo, time, cap)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#eff6ff;strokeColor=#2563eb;strokeWidth=2;fontColor=#1e3a8a;shadow=1;spacing=8;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="30" y="210" width="290" height="135" as="geometry" />
        </mxCell>

        <!-- 2A. Manual Baseline -->
        <mxCell id="b2" value="&lt;b style=&quot;font-size:13px;&quot;&gt;2A. Manual Baseline (QA Analyst)&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:11px;&quot;&gt;Enter 20 rows in &lt;font face=&quot;Courier New&quot;&gt;manual_log_template.csv&lt;/font&gt;&lt;br/&gt;• Human row-by-row scan: &lt;b&gt;O(n)&lt;/b&gt;&lt;br/&gt;• Stopwatch seconds, conflicts missed, errors&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#fffbeb;strokeColor=#d97706;strokeWidth=2;fontColor=#78350f;shadow=1;spacing=8;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="400" y="142" width="300" height="110" as="geometry" />
        </mxCell>

        <!-- 2B. Bakante Replay -->
        <mxCell id="b3" value="&lt;b style=&quot;font-size:13px;&quot;&gt;2B. Bakante Replay (Automated)&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:11px;&quot;&gt;Replay 20 rows in isolated SQLite &lt;font face=&quot;Courier New&quot;&gt;:memory:&lt;/font&gt;&lt;br/&gt;• Indexed Binary Search: &lt;b&gt;O(log n)&lt;/b&gt; + Gatekeeper&lt;br/&gt;• Measured: ~5 ms total, &lt;b&gt;0% Conflicts, 0% Errors&lt;/b&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#f0fdf4;strokeColor=#16a34a;strokeWidth=2;fontColor=#14532d;shadow=1;spacing=8;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="400" y="312" width="300" height="110" as="geometry" />
        </mxCell>

        <!-- 3. Section 9.1 Equations -->
        <mxCell id="b4" value="&lt;b style=&quot;font-size:13px;&quot;&gt;3. Section 9.1 Equations&lt;/b&gt;&lt;br/&gt;&lt;b&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:11px;&quot;&gt;% Imp = |Base − New| ÷ Base × 100&lt;/font&gt;&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:11px;&quot;&gt;• Conflict % = (Missed ÷ 20) × 100&lt;br/&gt;• Error % = (Admitted ÷ 20) × 100&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#eef2ff;strokeColor=#4f46e5;strokeWidth=2;fontColor=#312e81;shadow=1;spacing=8;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="775" y="210" width="275" height="135" as="geometry" />
        </mxCell>

        <!-- 4. Official 3-Row Scorecard -->
        <mxCell id="b5" value="&lt;b style=&quot;font-size:13px;&quot;&gt;4. Official Scorecard&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:11.5px;color:#e2e8f0;&quot;&gt;1. Processing Time (s)&lt;br/&gt;2. Conflict Rate (%)&lt;br/&gt;3. Error Rate (%)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#0f295c;strokeColor=#1e3a8a;strokeWidth=2;fontColor=#ffffff;shadow=1;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1105" y="218" width="225" height="120" as="geometry" />
        </mxCell>

        <!-- Footer -->
        <mxCell id="bfooter" value="&lt;b&gt;Reproducibility:&lt;/b&gt;&amp;nbsp;&amp;nbsp;Run &lt;font face=&quot;Courier New&quot;&gt;npm run benchmark&lt;/font&gt; or click &lt;b&gt;Run 20-Request Replay&lt;/b&gt; in the web app to verify all 3 metrics live during the pitch." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#cbd5e1;fontColor=#334155;fontSize=11.5;" vertex="1" parent="1">
          <mxGeometry x="30" y="485" width="1300" height="36" as="geometry" />
        </mxCell>

        <!-- Clean Orthogonal Edges -->
        <mxCell id="bf1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#d97706;strokeWidth=2;endArrow=block;endFill=1;exitX=1;exitY=0.35;entryX=0;entryY=0.5;" edge="1" parent="1" source="b1" target="b2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="bf2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#16a34a;strokeWidth=2;endArrow=block;endFill=1;exitX=1;exitY=0.65;entryX=0;entryY=0.5;" edge="1" parent="1" source="b1" target="b3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="bf3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#d97706;strokeWidth=2;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.35;" edge="1" parent="1" source="b2" target="b4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="bf4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#16a34a;strokeWidth=2;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.65;" edge="1" parent="1" source="b3" target="b4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="bf5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0f295c;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="b4" target="b5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
