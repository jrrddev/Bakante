        <mxCell id="s1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fillColor=#ffffff;strokeColor=#334155;strokeWidth=1.5;fontColor=#0f172a;fontSize=12;" value="Start: User Enters Booking&#xa;(Room, Date, Start–End, Attendees)&#xa;min = (Hour × 60) + Min" vertex="1">
          <mxGeometry height="75" width="210" x="40" y="130" as="geometry" />
        </mxCell>
        <mxCell id="s2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#334155;strokeWidth=1.5;fontColor=#0f172a;fontSize=12;align=left;spacingLeft=12;" value="1. Input Check [O(1)]&#xa;• Valid room &amp; no blank fields&#xa;• 3 AM ≤ start &lt; end ≤ 11 PM&#xa;• 1 ≤ attendees ≤ capacity" vertex="1">
          <mxGeometry height="90" width="225" x="300" y="122" as="geometry" />
        </mxCell>
        <mxCell id="d1" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#334155;strokeWidth=1.5;fontColor=#0f172a;fontSize=12;fontStyle=1;" value="Valid&#xa;Details?" vertex="1">
          <mxGeometry height="85" width="95" x="570" y="125" as="geometry" />
        </mxCell>
        <mxCell id="err-box" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fillColor=#fef2f2;strokeColor=#dc2626;strokeWidth=1.5;fontColor=#991b1b;fontSize=12;fontStyle=1;" value="Block Bad Input&#xa;(0% Error Rate)" vertex="1">
          <mxGeometry height="60" width="175" x="530" y="285" as="geometry" />
        </mxCell>
        <mxCell id="s3" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#334155;strokeWidth=1.5;fontColor=#0f172a;fontSize=12;align=left;spacingLeft=12;" value="2. Fast Schedule Search [O(log n)]&#xa;Sorted Binary Search by start time&#xa;Overlap: startA &lt; endB AND startB &lt; endA" vertex="1">
          <mxGeometry height="90" width="250" x="720" y="122" as="geometry" />
        </mxCell>
        <mxCell id="d2" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#334155;strokeWidth=1.5;fontColor=#0f172a;fontSize=12;fontStyle=1;" value="Time&#xa;Overlaps?" vertex="1">
          <mxGeometry height="85" width="95" x="1015" y="125" as="geometry" />
        </mxCell>
