<mxfile host="Electron">
  <diagram name="1. Booking &amp; Conflict Flow" id="bakante-booking-flow">
    <mxGraphModel dx="1320" dy="760" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1240" pageHeight="620" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Plain Title -->
        <mxCell id="t1" value="Bakante — Booking &amp; Conflict-Prevention Flowchart" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=16;fontStyle=1;fontColor=#0f172a;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="600" height="32" as="geometry" />
        </mxCell>

        <!-- Start Oval -->
        <mxCell id="s1" value="Start: User Enters Booking&#xa;(Room, Date, Start–End, Attendees)&#xa;min = (Hour × 60) + Min" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fillColor=#ffffff;strokeColor=#334155;strokeWidth=1.5;fontColor=#0f172a;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="130" width="210" height="75" as="geometry" />
        </mxCell>

        <!-- Input Check -->
        <mxCell id="s2" value="1. Input Check [O(1)]&#xa;• Valid room &amp; no blank fields&#xa;• 3 AM ≤ start &lt; end ≤ 11 PM&#xa;• 1 ≤ attendees ≤ capacity" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#334155;strokeWidth=1.5;fontColor=#0f172a;fontSize=12;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="300" y="122" width="225" height="90" as="geometry" />
        </mxCell>

        <!-- Decision 1 -->
        <mxCell id="d1" value="Valid&#xa;Details?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#334155;strokeWidth=1.5;fontColor=#0f172a;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="570" y="125" width="95" height="85" as="geometry" />
        </mxCell>

        <!-- Reject -->
        <mxCell id="err-box" value="Block Bad Input&#xa;(0% Error Rate)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fillColor=#fef2f2;strokeColor=#dc2626;strokeWidth=1.5;fontColor=#991b1b;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="530" y="285" width="175" height="60" as="geometry" />
        </mxCell>

        <!-- Binary Search -->
        <mxCell id="s3" value="2. Fast Schedule Search [O(log n)]&#xa;Sorted Binary Search by start time&#xa;Overlap: startA &lt; endB AND startB &lt; endA" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#334155;strokeWidth=1.5;fontColor=#0f172a;fontSize=12;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="720" y="122" width="250" height="90" as="geometry" />
        </mxCell>

        <!-- Decision 2 -->
        <mxCell id="d2" value="Time&#xa;Overlaps?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#334155;strokeWidth=1.5;fontColor=#0f172a;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1015" y="125" width="95" height="85" as="geometry" />
        </mxCell>

        <!-- Save -->
        <mxCell id="ok-box" value="Booking Saved!&#xa;Saved to Turso (0% Conflicts)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fillColor=#f0fdf4;strokeColor=#16a34a;strokeWidth=1.5;fontColor=#166534;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="960" y="285" width="215" height="65" as="geometry" />
        </mxCell>

        <!-- Suggest Alternatives -->
        <mxCell id="alt-box" value="3. Suggest Best-Fit Alternative&#xa;• Open gaps: gap ≥ duration&#xa;• Score = 45(seat fit) + 35(gear) + 20(same bldg)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#334155;strokeWidth=1.5;fontColor=#0f172a;fontSize=11.5;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="710" y="395" width="285" height="80" as="geometry" />
        </mxCell>

        <!-- Edges -->
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#334155;strokeWidth=1.5;endArrow=classic;endFill=1;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#334155;strokeWidth=1.5;endArrow=classic;endFill=1;" edge="1" parent="1" source="s2" target="d1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#dc2626;strokeWidth=1.5;fontColor=#dc2626;fontStyle=1;labelBackgroundColor=#ffffff;endArrow=classic;endFill=1;" edge="1" parent="1" source="d1" target="err-box"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#334155;strokeWidth=1.5;fontColor=#0f172a;fontStyle=1;labelBackgroundColor=#ffffff;endArrow=classic;endFill=1;" edge="1" parent="1" source="d1" target="s3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#334155;strokeWidth=1.5;endArrow=classic;endFill=1;" edge="1" parent="1" source="s3" target="d2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e6" value="No (Free)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#16a34a;strokeWidth=1.5;fontColor=#16a34a;fontStyle=1;labelBackgroundColor=#ffffff;endArrow=classic;endFill=1;" edge="1" parent="1" source="d2" target="ok-box"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e7" value="Yes (Busy)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#334155;strokeWidth=1.5;fontColor=#0f172a;fontStyle=1;labelBackgroundColor=#ffffff;endArrow=classic;endFill=1;exitX=1;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="d2" target="alt-box"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1195" y="168" /><mxPoint x="1195" y="435" /></Array></mxGeometry></mxCell>
        <mxCell id="e8" value="Pick Alternative (Re-check)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;strokeColor=#2563eb;strokeWidth=1.5;fontColor=#2563eb;fontStyle=1;labelBackgroundColor=#ffffff;endArrow=classic;endFill=1;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="alt-box" target="s3"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram name="2. System Architecture" id="bakante-architecture">
    <mxGraphModel dx="1240" dy="620" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1180" pageHeight="520" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="at1" value="Bakante — System Architecture Flowchart" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=16;fontStyle=1;fontColor=#0f172a;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="520" height="32" as="geometry" />
        </mxCell>

        <mxCell id="a-client" value="Web App (client/)&#xa;React + Vite + Tailwind&#xa;Schedule · Modal · Scorecard · Algorithm" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#334155;strokeWidth=1.5;fontColor=#0f172a;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="130" width="230" height="90" as="geometry" />
        </mxCell>

        <mxCell id="a-vercel" value="Vercel Router&#xa;/api/* → Server&#xa;/* → Web App" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#334155;strokeWidth=1.5;fontColor=#0f172a;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="330" y="135" width="160" height="80" as="geometry" />
        </mxCell>

        <mxCell id="a-server" value="API Server (server/)&#xa;Express Serverless API&#xa;Bookings, Batch Import &amp; Reset" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#334155;strokeWidth=1.5;fontColor=#0f172a;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="550" y="130" width="220" height="90" as="geometry" />
        </mxCell>

        <mxCell id="a-turso" value="Turso Cloud Database&#xa;9 ISATU Rooms &amp; Live Bookings" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#ffffff;strokeColor=#334155;strokeWidth=1.5;fontColor=#0f172a;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="870" y="75" width="220" height="90" as="geometry" />
        </mxCell>

        <mxCell id="a-mem" value="In-Memory Sandbox&#xa;~5 ms Scorecard &amp; Excel Replay" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#ffffff;strokeColor=#334155;strokeWidth=1.5;fontColor=#0f172a;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="870" y="205" width="220" height="90" as="geometry" />
        </mxCell>

        <mxCell id="a-shared" value="Shared Rules &amp; Equations (shared/)&#xa;Input Validation · Binary Search · Best-Fit Score · Scorecard Formula" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#334155;strokeWidth=1.5;fontColor=#0f172a;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="200" y="320" width="470" height="75" as="geometry" />
        </mxCell>

        <mxCell id="ae1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#334155;strokeWidth=1.5;endArrow=classic;endFill=1;" edge="1" parent="1" source="a-client" target="a-vercel"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ae2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#334155;strokeWidth=1.5;endArrow=classic;endFill=1;" edge="1" parent="1" source="a-vercel" target="a-server"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ae3" value="Live CRUD" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#334155;strokeWidth=1.5;fontColor=#0f172a;labelBackgroundColor=#ffffff;endArrow=classic;endFill=1;exitX=1;exitY=0.3;entryX=0;entryY=0.5;" edge="1" parent="1" source="a-server" target="a-turso"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ae4" value="Replay" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#334155;strokeWidth=1.5;fontColor=#0f172a;labelBackgroundColor=#ffffff;endArrow=classic;endFill=1;exitX=1;exitY=0.7;entryX=0;entryY=0.5;" edge="1" parent="1" source="a-server" target="a-mem"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ae5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;strokeColor=#64748b;strokeWidth=1.5;endArrow=classic;endFill=1;exitX=0.5;exitY=1;entryX=0.2;entryY=0;" edge="1" parent="1" source="a-client" target="a-shared"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ae6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;strokeColor=#64748b;strokeWidth=1.5;endArrow=classic;endFill=1;exitX=0.5;exitY=1;entryX=0.8;entryY=0;" edge="1" parent="1" source="a-server" target="a-shared"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram name="3. 3-Way Scorecard Flow" id="bakante-baseline-flow">
    <mxGraphModel dx="1240" dy="620" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="520" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="bt1" value="Bakante — 3-Way Scorecard Flowchart" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=16;fontStyle=1;fontColor=#0f172a;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="520" height="32" as="geometry" />
        </mxCell>

        <mxCell id="b1" value="20 Test Requests&#xa;10 Valid · 6 Conflicts (30%) · 4 Errors (20%)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fillColor=#ffffff;strokeColor=#334155;strokeWidth=1.5;fontColor=#0f172a;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="210" width="235" height="75" as="geometry" />
        </mxCell>

        <mxCell id="b2" value="1. Manual Walk-In &amp; Sheet&#xa;360.0 sec · 30% conflicts · 20% errors" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#334155;strokeWidth=1.5;fontColor=#0f172a;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="345" y="100" width="260" height="70" as="geometry" />
        </mxCell>

        <mxCell id="b2m" value="2. Bakante Manual (1-by-1 Form)&#xa;120.0 sec (66.67% faster) · 0% conflicts &amp; errors" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#334155;strokeWidth=1.5;fontColor=#0f172a;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="345" y="212" width="260" height="70" as="geometry" />
        </mxCell>

        <mxCell id="b3" value="3. Bakante Batch (Excel / CSV)&#xa;~0.005 sec (99.99% faster) · 0% conflicts &amp; errors" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#334155;strokeWidth=1.5;fontColor=#0f172a;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="345" y="325" width="260" height="70" as="geometry" />
        </mxCell>

        <mxCell id="b4" value="Section 9.1 Formula&#xa;% Gain = |Manual − Bakante| ÷ Manual × 100" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#334155;strokeWidth=1.5;fontColor=#0f172a;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="675" y="210" width="250" height="75" as="geometry" />
        </mxCell>

        <mxCell id="b5" value="Final Scorecard&#xa;Time: 66.67% / 99.99% faster&#xa;Conflicts &amp; Errors: 100% cut" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fillColor=#f0fdf4;strokeColor=#16a34a;strokeWidth=1.5;fontColor=#166534;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="980" y="205" width="190" height="85" as="geometry" />
        </mxCell>

        <mxCell id="bf1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#334155;strokeWidth=1.5;endArrow=classic;endFill=1;exitX=1;exitY=0.3;entryX=0;entryY=0.5;" edge="1" parent="1" source="b1" target="b2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="bf2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#334155;strokeWidth=1.5;endArrow=classic;endFill=1;" edge="1" parent="1" source="b1" target="b2m"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="bf3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#334155;strokeWidth=1.5;endArrow=classic;endFill=1;exitX=1;exitY=0.7;entryX=0;entryY=0.5;" edge="1" parent="1" source="b1" target="b3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="bf4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#334155;strokeWidth=1.5;endArrow=classic;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.3;" edge="1" parent="1" source="b2" target="b4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="bf5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#334155;strokeWidth=1.5;endArrow=classic;endFill=1;" edge="1" parent="1" source="b2m" target="b4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="bf6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#334155;strokeWidth=1.5;endArrow=classic;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.7;" edge="1" parent="1" source="b3" target="b4"><mxGeometry relative="1" as="geometry" /></mxCell>
